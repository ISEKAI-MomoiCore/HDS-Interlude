{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "types": ["node", "yml-register/types"],
    // strict 分批启用。第一批四项零报错；第二批 noImplicitAny 的 57 处
    // 已全部补类型标注修复（2026-10-28）。
    // 尚未开启：strictNullChecks（125 处）、strictPropertyInitialization（依赖 strictNullChecks）。
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "strictFunctionTypes": true,
    "useUnknownInCatchVariables": true,
    "noImplicitAny": true
  },
  "include": ["src"]
}

{
  "name": "koishi-plugin-hds-interlude",
  "version": "1.0.1",
  "description": "A time-aware, persistent narrative chat framework for Koishi.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "prepack": "node scripts/ensure-fresh-bundle.mjs",
    "build:client": "vite build client --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false --composite false --noUnusedLocals --noUnusedParameters",
    "test": "node --import tsx --test test/*.test.ts",
    "test:model": "node --import tsx --test test/model-behavior.test.ts",
    "realism": "node --env-file-if-exists=test/realism/.env --import tsx test/realism/harness.ts",
    "realism:review": "node --import tsx test/realism/build-review.ts",
    "realism:profile:migrate": "node --import tsx test/realism/harness.ts --migrate",
    "realism:ui:build": "vite build --config test/realism/ui/vite.config.mts",
    "realism:ui": "npm run realism:ui:build && node --env-file-if-exists=test/realism/.env --import tsx test/realism/server.ts",
    "realism:serve": "node --env-file-if-exists=test/realism/.env --import tsx test/realism/server.ts"
  },
  "files": [
    "lib/**",
    "./README.md",
    "./DEPLOYMENT_GUIDE.md",
    "./CONFIGURATION_GUIDE.md",
    "./BEGINNER_GUIDE.md",
    "./command.md",
    "./新人上手一条龙配置服务v1.0.1.html",
    "docs/CONSOLE_CONFIG_CENTER_DESIGN.md",
    "docs/NARRATIVE_PLATFORM_DECOUPLING_DESIGN.md",
    "docs/PLATFORM_AWARENESS_DESIGN.md",
    "docs/PLATFORM_ASSUMPTIONS_INBOUND.md",
    "docs/RESEARCH_AGENT_DESIGN.md",
    "docs/RESPONSIVENESS_INSPIRATION_DESIGN.md",
    "docs/SERVICE_EXTRACTION_PLAN.md",
    "docs/SERVICE_EXTRACTION_P8_DESIGN.md",
    "docs/experiments/2026-11-25-focus-driven-event-library-design.md",
    "docs/experiments/2026-11-25-per-bubble-send-delay-design.md",
    "docs/README.md",
    "docs/assets/readme/**",
    "docs/FORWARD_MESSAGE_READING_DESIGN.md",
    "docs/GROUP_HISTORICAL_IMAGE_CONTEXT_DESIGN.md",
    "docs/ARCHITECTURE.md",
    "docs/PROACTIVE_ACTION_UNIFICATION_DESIGN.md",
    "docs/SCRIPT_CENTRIC_ARCHITECTURE_REDESIGN.md",
    "docs/V2_IN_PLACE_REFACTOR_IMPLEMENTATION_FORM.md",
    "docs/V2_VS_BETA10_COMPARISON.md",
    "docs/ALTER_SYSTEM.md",
    "docs/AGENCY_WINDOW.md",
    "docs/SCHEDULE_PREPLAN.md",
    "docs/CHANGELOG.md",
    "docs/SECURITY.md",
    "docs/WORLD_EVENT_SEEDER_DESIGN.md",
    "docs/GROUP_WILLINGNESS_TIERS.md",
    "docs/WECHAT_CHANNEL_PLAN.md",
    "docs/QZONE_FEED_DESIGN.md",
    "docs/MULTI_CHANNEL_SINGLE_STORY_DESIGN.md",
    "docs/MULTI_CHANNEL_IMPLEMENTATION_ROADMAP.md",
    "docs/INDIRECT_SUBJECT_DESIGN.md",
    "docs/LONG_HORIZON_NARRATIVE_GUIDANCE_DESIGN.md",
    "docs/OFFLINE_ATTENTION_EXPERIMENT.md",
    "docs/development",
    "docs/development/**",
    "client-dist"
  ],
  "keywords": [
    "koishi",
    "chatbot",
    "roleplay",
    "narrative"
  ],
  "license": "AGPL-3.0",
  "koishi": {
    "service": {
      "optional": [
        "puppeteer",
        "console"
      ]
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.7",
    "koishi-plugin-puppeteer": "^3.9.0",
    "@koishijs/console": "^5.30.11"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-puppeteer": {
      "optional": true
    },
    "@koishijs/console": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-console": "^5.30.11",
    "@vitejs/plugin-vue": "^5.2.0",
    "@minatojs/driver-sqlite": "^4.7.0",
    "@types/node": "^22.7.5",
    "koishi-plugin-puppeteer": "^3.9.0",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0",
    "yml-register": "^1.2.5"
  },
  "dependencies": {
    "qface": "^1.4.1",
    "undici": "^7.30.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/MomoiCore/HDS-Interlude.git"
  },
  "homepage": "https://gitee.com/MomoiCore/HDS-Interlude#readme",
  "bugs": {
    "url": "https://gitee.com/MomoiCore/HDS-Interlude/issues"
  }
}
